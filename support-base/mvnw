#!/bin/sh
set -eu
BASE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VERSION="3.9.11"
HOME_MAVEN="${HOME}/.m2/wrapper/dists/apache-maven-${VERSION}"
MVN="$HOME_MAVEN/bin/mvn"
if [ ! -x "$MVN" ]; then
  echo "[Maven Wrapper] Descargando Maven ${VERSION} (requiere internet)..."
  mkdir -p "${HOME}/.m2/wrapper/dists"
  ARCHIVE="${HOME}/.m2/wrapper/dists/apache-maven-${VERSION}-bin.tar.gz"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${VERSION}/apache-maven-${VERSION}-bin.tar.gz"
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$ARCHIVE"
  else
    echo "[ERROR] Se requiere curl o wget para descargar Maven." >&2
    exit 1
  fi
  tar -xzf "$ARCHIVE" -C "${HOME}/.m2/wrapper/dists"
  rm -f "$ARCHIVE"
fi
exec "$MVN" "$@"
